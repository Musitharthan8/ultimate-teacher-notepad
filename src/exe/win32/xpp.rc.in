#include "winver.h"

0 ICON "xournalpp.ico"

VS_VERSION_INFO VERSIONINFO
FILEVERSION 0, 2, 1, 0
PRODUCTVERSION 0, 2, 1, 0
FILEOS VOS__WINDOWS32
FILETYPE VFT_APP
BEGIN
    BLOCK "StringFileInfo"
	BEGIN
		/* Lang = US English, Charset = Multilingual */
		BLOCK "040904E4"
		BEGIN
			VALUE "CompanyName", "UTN contributors\0"
			VALUE "FileDescription", "Ultimate Teacher Notepad\0"
			VALUE "FileVersion", "0.2.1-beta\0"
			VALUE "ProductVersion", "0.2.1-beta\0"
			VALUE "ProductName", "Ultimate Teacher Notepad\0"
			VALUE "LegalCopyright", "\0"
			VALUE "LegalTrademarks", "\0"
			VALUE "Comments", "Based on Xournal++; GNU GPLv2 or later\0"
		END
	END

	BLOCK "VarFileInfo"
	BEGIN
		VALUE "Translation", 0x409, 1252
	END
END